# 换行符：mac/Linux 的脚本必须是 LF，否则 macOS 上 bash 会报
# `$'\r': command not found`（Windows 上 core.autocrlf=true 正是会干这事）。
*.sh   text eol=lf
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# 二进制资源别让 git 去做换行/编码转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.icns binary
*.wav  binary
*.mp3  binary
*.ttf  binary
